    stopSoundEffectOnAdvance: 1
  - speakerId: MC
    text: "Let\u2019s say you have a life ending disease, that will kill you in a
      week and with treatment a couple months."
    scenePicture: {fileID: 0}
    fadeToBlack: 0
    fadeDuration: 0
    endDoctorIntro: 0
    expression: 
    pose: 
    voiceCue: 
    voiceCueVolume: 0
    soundEffect: {fileID: 0}
    soundEffectVolume: 0
    stopSoundEffectOnAdvance: 1
  - speakerId: Bar
    text: Hmm?
    scenePicture: {fileID: 0}
    fadeToBlack: 0
    fadeDuration: 0
    endDoctorIntro: 0
    expression: 
