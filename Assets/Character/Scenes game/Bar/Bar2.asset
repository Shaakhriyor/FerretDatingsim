    soundEffectVolume: 0.272
    stopSoundEffectOnAdvance: 1
  - speakerId: MC
    text: But there was an alternative method that is risky and you have no idea
      what the procedure is but it could cure you completely. What would you do.
    scenePicture: {fileID: 0}
    fadeToBlack: 0
    fadeDuration: 0
    endDoctorIntro: 0
    expression: 
    pose: 
    voiceCue: 
    voiceCueVolume: 0
