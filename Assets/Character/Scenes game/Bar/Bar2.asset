    voiceCue: 
    voiceCueVolume: 0
    soundEffect: {fileID: 8300000, guid: 40a50c881c2402e459ea0966cfcebd55, type: 3}
    soundEffectVolume: 0.431
    stopSoundEffectOnAdvance: 0
  - speakerId: Bar
    text: "Well I would see if I\u2019m content with my life as it is. So personally
